{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug test at cursor",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "args": ["-test.run", "${selectedText}", "-test.v"]
    },
    {
      "name": "Debug tests in current package",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "args": ["-test.v"]
    },
    {
      "name": "Debug conformance suite",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${workspaceFolder}",
      "args": ["-test.run", "Conformance", "-test.v"]
    },
    {
      "name": "Debug example",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${fileDirname}",
      "console": "integratedTerminal"
    }
  ]
}
